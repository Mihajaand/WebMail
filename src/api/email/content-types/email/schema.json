{
  "kind": "collectionType",
  "collectionName": "emails",
  "info": {
    "singularName": "email",
    "pluralName": "emails",
    "displayName": "Email",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "from": {
      "type": "email",
      "required": true
    },
    "to": {
      "type": "json",
      "required": true
    },
    "cc": {
      "type": "json"
    },
    "bcc": {
      "type": "json"
    },
    "subject": {
      "type": "string",
      "required": true
    },
    "body": {
      "type": "text",
      "required": true
    },
    "attachments": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "folder": {
      "type": "enumeration",
      "enum": [
        "inbox",
        "sent",
        "draft",
        "trash",
        "spam"
      ]
    },
    "isRead": {
      "type": "boolean"
    },
    "isStarred": {
      "type": "boolean"
    },
    "isImportant": {
      "type": "boolean"
    },
    "threadId": {
      "type": "string"
    },
    "sentAt": {
      "type": "datetime"
    },
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "hasExternalRecipients": {
      "type": "boolean"
    },
    "externalRecipients": {
      "type": "json"
    },
    "internalRecipients": {
      "type": "json"
    },
    "deliveryStatus": {
      "type": "enumeration",
      "enum": [
        "delivered",
        "pending",
        "failed",
        "mixed"
      ]
    },
    "deliveredAt": {
      "type": "datetime"
    }
  }
}
